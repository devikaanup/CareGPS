# ===========================================
# RouteEase Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Google Maps Platform ---
# Required for live routing and places. Get from https://console.cloud.google.com/
# Enable: Routes API, Places API (New), Maps JavaScript API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# --- LLM Configuration ---
# Provider: ollama | lmstudio | openai | anthropic | gemini
LLM_PROVIDER=ollama

# LM Studio (local OpenAI-compatible server)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=your_lm_studio_model_here

# Ollama (default local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI (future)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (future)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gemini (future)
GEMINI_API_KEY=your_gemini_api_key_here

# --- Server Configuration ---
HOST=0.0.0.0
PORT=8000
DEBUG=true

# --- CORS ---
# Comma-separated list of allowed origins for frontend
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
